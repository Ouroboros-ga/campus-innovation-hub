# 仅供本机开发复制为 .env 并由终端或部署系统导出；不要提交真实值。
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-local-development-secret-key-at-least-50-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 远程开发经 Vite + SSH 隧道联调时使用；production settings 只允许 HTTPS origin。
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://campus:replace-me@127.0.0.1:5432/campus_innovation_hub
# production 必须设置独立值；development 可以临时回退为 DJANGO_SECRET_KEY。
AUTH_THROTTLE_HMAC_KEY=replace-with-a-separate-local-hmac-key
# 招新期可显式设为 true；关闭时新账号进入 Django Admin 人工审核。
STUDENT_REGISTRATION_AUTO_ACTIVATE=false
MEDIA_STORAGE_BACKEND=local
MEDIA_URL=/media/
# 当前服务器由 Nginx 将此本机目录映射为同源 /media/；仅 local 使用。
MEDIA_ROOT=/var/lib/campus-innovation-hub/media
# 切换为 s3 时必须配置公开基地址，例如 https://oss.example.edu/campus-media
# MEDIA_STORAGE_BACKEND=s3
# MEDIA_PUBLIC_BASE_URL=https://oss.example.edu/campus-media
# MEDIA_S3_ENDPOINT_URL=https://s3-compatible-endpoint.example
# MEDIA_S3_REGION=replace-with-region
# MEDIA_S3_BUCKET=replace-with-single-bucket
# MEDIA_S3_ACCESS_KEY_ID=replace-with-access-key
# MEDIA_S3_SECRET_ACCESS_KEY=replace-with-secret
# MEDIA_S3_OBJECT_PREFIX=campus-media
