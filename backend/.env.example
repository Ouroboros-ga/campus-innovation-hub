# 仅供本机开发复制为 .env 并由终端或部署系统导出；不要提交真实值。
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-local-development-secret-key-at-least-50-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://campus:replace-me@127.0.0.1:5432/campus_innovation_hub
MEDIA_STORAGE_BACKEND=local
MEDIA_URL=/media/
