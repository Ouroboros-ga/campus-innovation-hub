# 临时公网 HTTP 层的环境文件示例。实际文件由 provision-temporary-public.sh 生成到
# /etc/campus-innovation-hub/temporary.env，权限 0640，仅由 campus-innovation-hub-temp.service 读取，绝不提交。
DJANGO_SETTINGS_MODULE=config.settings.temporary
DJANGO_SECRET_KEY=REPLACE_WITH_DEV_SECRET_KEY
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_PUBLIC_IP,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://REPLACE_WITH_PUBLIC_IP,http://localhost,http://127.0.0.1
DATABASE_URL=REPLACE_WITH_DEV_DATABASE_URL
AUTH_THROTTLE_HMAC_KEY=REPLACE_WITH_DEV_HMAC_KEY
MEDIA_STORAGE_BACKEND=local
MEDIA_URL=/media/
MEDIA_ROOT=/var/lib/campus-innovation-hub-dev/media
DJANGO_STATIC_ROOT=/var/lib/campus-innovation-hub-dev/static
