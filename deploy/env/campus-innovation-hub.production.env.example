# 此文件只说明变量名。复制后的实际文件放在 /etc/campus-innovation-hub/production.env，权限 0640，绝不提交。
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=REPLACE_WITH_DEPLOYMENT_SECRET
AUTH_THROTTLE_HMAC_KEY=REPLACE_WITH_SEPARATE_DEPLOYMENT_SECRET
# 招新期保持 true；结束后可切回 false 恢复人工审核。
STUDENT_REGISTRATION_AUTO_ACTIVATE=true
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_EXACT_PUBLIC_HOST
DJANGO_CSRF_TRUSTED_ORIGINS=https://REPLACE_WITH_EXACT_PUBLIC_HOST
DJANGO_STATIC_ROOT=/var/lib/campus-innovation-hub/static
DJANGO_SECURE_HSTS_SECONDS=300
DATABASE_URL=REPLACE_WITH_APPLICATION_DATABASE_URL
MEDIA_STORAGE_BACKEND=local
MEDIA_URL=/media/
MEDIA_ROOT=/var/lib/campus-innovation-hub/media

# 仅在获得预发布 bucket 的授权后启用。公开基地址应包含已授权 prefix。
# MEDIA_STORAGE_BACKEND=s3
# MEDIA_PUBLIC_BASE_URL=https://REPLACE_WITH_APPROVED_MEDIA_HOST/REPLACE_WITH_APPROVED_PREFIX
# MEDIA_S3_ENDPOINT_URL=https://REPLACE_WITH_S3_ENDPOINT
# MEDIA_S3_REGION=REPLACE_WITH_REGION
# MEDIA_S3_BUCKET=REPLACE_WITH_SINGLE_BUCKET
# MEDIA_S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
# MEDIA_S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET
# MEDIA_S3_OBJECT_PREFIX=REPLACE_WITH_APPROVED_PREFIX
